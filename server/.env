# ============================================================
# MOVA SERVER CONFIGURATION
# ============================================================

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------

PORT=5000

NODE_ENV=development


# ------------------------------------------------------------
# MONGODB
# ------------------------------------------------------------

MONGO_URI=mongodb://127.0.0.1:27017/mova?retryWrites=false


# ------------------------------------------------------------
# FRONTEND / CORS
# ------------------------------------------------------------
#
# MOVA development:
# http://localhost:5173
#
# MOVA Vite preview / PWA testing:
# http://localhost:4173
#
# The server CORS configuration should allow both origins.
#

CLIENT_URL=http://localhost:5173,http://localhost:4173


# ------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------

JWT_SECRET=mova_super_secret_change_this_later


# ------------------------------------------------------------
# EMAIL / SMTP
# ------------------------------------------------------------
#
# Replace these values with your real Gmail account and
# Gmail App Password when email functionality is enabled.
#

SMTP_HOST=smtp.gmail.com

SMTP_PORT=587

SMTP_SECURE=false

SMTP_USER=yourgmailaddress@gmail.com

SMTP_PASSWORD=your-16-character-app-password

SMTP_FROM=MOVA <yourgmailaddress@gmail.com>