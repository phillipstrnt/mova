NODE_ENV=production
PORT=10000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
CLIENT_URL=https://your-mova-frontend.vercel.app
JWT_SECRET=generate-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional internet-grounded report assistant (keep the key server-side)
BRAVE_SEARCH_API_KEY=

# Required for production password-reset verification codes
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
